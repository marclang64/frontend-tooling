{
    "name": "@marclang64/frontend-tooling",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "exports": {
        "./eslint": "./configs/eslint/index.mjs",
        "./prettier": "./configs/prettier.config.mjs",
        "./typescript": "./configs/typescript/tsconfig.base.json",
        "./stylelint": "./configs/stylelint.config.mjs",
        "./stylelint/css": "./configs/stylelint.css.config.mjs",
        "./eslint/environment": "./configs/eslint/environment.mjs"
    },
    "files": [
        "configs/",
        "bin/",
        "src/"
    ],
    "description": "Reusable frontend quality tools and project initializer.",
    "license": "MIT",
    "scripts": {
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --project examples/vanilla-ts/tsconfig.json && tsc --project examples/react/tsconfig.json",
        "stylelint": "stylelint \"examples/**/*.{css,scss}\" --config configs/stylelint.config.mjs",
        "stylelint:fix": "stylelint \"examples/**/*.{css,scss}\" --config configs/stylelint.config.mjs --fix",
        "test:integration": "node --test tests/integration/*.test.mjs",
        "test": "node --test tests/integration/*.test.mjs"
    },
    "devDependencies": {
        "@types/react": "^19.3.0",
        "react": "^19.3.1"
    },
    "dependencies": {
        "@eslint-react/eslint-plugin": "^5.30.6",
        "@eslint/js": "^10.0.1",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.14.0",
        "prettier": "^3.10.1",
        "stylelint": "^18.1.0",
        "stylelint-config-recommended-scss": "^18.0.0",
        "stylelint-config-standard": "^41.1.0",
        "stylelint-config-standard-scss": "^18.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.74.0"
    },
    "bin": {
        "frontend-tooling": "bin/frontend-tooling.mjs"
    },
    "engines": {
        "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
    }
}
