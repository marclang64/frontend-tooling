{
    "name": "@marclang64/frontend-tooling",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "exports": {
        "./eslint": "./configs/eslint/index.mjs",
        "./prettier": "./configs/prettier.config.mjs",
        "./typescript": "./configs/typescript/tsconfig.base.json",
        "./stylelint": "./configs/stylelint.config.mjs"
    },
    "files": [
        "configs/"
    ],
    "description": "reusable configurations for modern frontend development.",
    "license": "MIT",
    "scripts": {
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --project examples/vanilla-ts/tsconfig.json && tsc --project examples/react/tsconfig.json",
        "stylelint": "stylelint \"examples/**/*.{css,scss}\" --config configs/stylelint.config.mjs",
        "stylelint:fix": "stylelint \"examples/**/*.{css,scss}\" --config configs/stylelint.config.mjs --fix",
        "test:integration": "node --test tests/integration/*.test.mjs"
    },
    "devDependencies": {
        "@types/react": "^19.3.0",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.14.0",
        "npm": "^12.2.3",
        "prettier": "^3.10.1",
        "react": "^19.3.1",
        "stylelint": "^18.0.0",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "@eslint/js": "^9.39.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "stylelint-config-standard-scss": "^18.0.0",
        "typescript-eslint": "^8.73.0"
    },
    "peerDependencies": {
        "eslint": "^9.0.0",
        "stylelint": "^18.0.0",
        "typescript": "^6.0.0"
    },
    "peerDependenciesMeta": {
        "typescript": {
            "optional": true
        },
        "stylelint": {
            "optional": true
        }
    }
}
